<?xml version="1.0"?>
<package format="3">
  <name>robosub_bringup</name>
  <version>0.1.0</version>
  <description>Robot entry point and developer tuning tools.</description>
  <maintainer email="crt@caltech.edu">Caltech Robotics Team</maintainer>
  <license>MIT</license>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>robosub_sim</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- robosub_vision is optional in sim and checked when real vision is used. -->
  <export><build_type>ament_python</build_type></export>
</package>
