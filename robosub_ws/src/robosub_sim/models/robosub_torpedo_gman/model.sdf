<?xml version="1.0"?>
<sdf version="1.11">  <model name="robosub_torpedo_gman">
    <static>1</static>

    <include>
      <uri>model://robosub_buoy</uri>
    </include>

    <link name="box_buoy">
      <visual name="box_buoy_vis">
        <pose>0 0 1.1096 1.5707 1.5707 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub_torpedo_gman/model.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="box_buoy_collide">
        <pose>0 0 1.1096 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub_torpedo_gman/model.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
