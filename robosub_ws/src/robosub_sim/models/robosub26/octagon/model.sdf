          </box>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://media/materials/textures/robosub26/Task05_Repair.png</albedo_map>
              <emissive_map>file://media/materials/textures/robosub26/Task05_Repair.png</emissive_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <link name="box_search">
      <pose>0 1.37 -0.2 0 0 0</pose>
      <visual name="box_search_vis">
        <geometry>
          <box>
            <size>0.305 0.01 0.305</size>
          </box>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://media/materials/textures/robosub26/Task05_Search.png</albedo_map>
              <emissive_map>file://media/materials/textures/robosub26/Task05_Search.png</emissive_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <link name="box_survey">
      <pose>0 -1.37 -0.2 0 0 3.14</pose>
      <visual name="box_survey_vis">
        <geometry>
          <box>
            <size>0.305 0.01 0.305</size>
          </box>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
