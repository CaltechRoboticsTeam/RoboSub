<?xml version="1.0"?>
<sdf version="1.11">  <model name="robosub_buoy_badge">
    <static>1</static>

    <include>
      <uri>model://robosub_buoy</uri>
    </include>

    <link name="box_badge">
      <pose>0 0 1.1096 0 0 0</pose>
      <visual name="box_badge_vis">
        <geometry>
          <box>
            <size>0.5842 0.01 1.1684</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://materials/scripts/badge.material</uri>
            <name>TexturedShape/badge</name>
          </script>
        </material>
      </visual>
      <collision name="box_badge_collide">
        <geometry>
          <box>
            <size>0.5842 0.01 1.1684</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
