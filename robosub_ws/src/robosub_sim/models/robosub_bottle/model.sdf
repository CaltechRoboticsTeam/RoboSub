<?xml version="1.0"?>
<sdf version="1.11">  <model name="robosub_bin_cover">
    <link name="bottle">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <visual name="bottle">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub_bottle/bottle.dae</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Purple</name>
          </script>
        </material>
      </visual>

      <collision name="bottle_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub_bottle/bottle.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
