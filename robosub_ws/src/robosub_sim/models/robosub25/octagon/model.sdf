<?xml version="1.0"?>
<sdf version="1.11">
  <model name="robosub25_octagon">
    <static>1</static>

    <link name="octagon">
      <pose>0 0 0 0 0 0</pose>
      <visual name="octagon_vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://octagon/octagon.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="octagon_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://octagon/octagon.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <link name="box_reef_shark">
      <pose>-1.37 0 -0.2 0 0 -1.57</pose>
      <visual name="box_reef_shark_vis">
        <geometry>
          <box>
            <size>0.305 0.01 0.305</size>
          </box>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://media/materials/textures/robosub25/Task01_ReefShark.png</albedo_map>
              <emissive_map>file://media/materials/textures/robosub25/Task01_ReefShark.png</emissive_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <link name="box_saw_fish">
      <pose>1.37 0 -0.2 0 0 1.57</pose>
      <visual name="box_saw_fish_vis">
        <geometry>
          <box>
            <size>0.305 0.01 0.305</size>
          </box>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://media/materials/textures/robosub25/Task01_Sawfish.png</albedo_map>
              <emissive_map>file://media/materials/textures/robosub25/Task01_Sawfish.png</emissive_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>