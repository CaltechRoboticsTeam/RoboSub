<?xml version="1.0"?>
<sdf version="1.11">  <model name="robosub23_octagon">
    <static>1</static>

    <link name="octagon">
      <pose>0 0 0 0 0 0</pose>
      <visual name="octagon_vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub23_octagon/octagon.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="octagon_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub23_octagon/octagon.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <link name="dhd">
      <pose>0 0 0 0 0 0</pose>
      <visual name="dhd_vis">
        <pose>0 0 -5 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub23_octagon/dhd.dae</uri>
          </mesh>
          <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
        </geometry>
      </visual>
      <collision name="dhd_collision">
        <pose>0 0 -5 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robosub23_octagon/dhd.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <collision name="dhd_collision_surface">
        <pose>0 0 -4.1 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2192 1.2192 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="DHD_image">
      <pose>0 0 -4.1 0 0 0</pose>
      <visual name="dhd_image">
        <geometry>
          <box>
            <size>1.2192 1.2192 0.005</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://materials/scripts/dhd.material</uri>
            <name>TexturedShape/2023_DHD</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
